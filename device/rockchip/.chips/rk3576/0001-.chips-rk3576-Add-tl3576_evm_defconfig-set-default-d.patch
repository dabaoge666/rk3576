diff --git a/.chips/rk3576/tl3576_evm_defconfig b/.chips/rk3576/tl3576_evm_defconfig
new file mode 100644
index 0000000..3f462ec
--- /dev/null
+++ b/.chips/rk3576/tl3576_evm_defconfig
@@ -0,0 +1,3 @@
