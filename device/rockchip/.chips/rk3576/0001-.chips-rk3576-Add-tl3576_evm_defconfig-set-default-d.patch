 .chips/rk3576/rockchip_defconfig   | 2 +-
 .chips/rk3576/tl3576_evm_defconfig | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)
 create mode 100644 .chips/rk3576/tl3576_evm_defconfig

diff --git a/.chips/rk3576/rockchip_defconfig b/.chips/rk3576/rockchip_defconfig
